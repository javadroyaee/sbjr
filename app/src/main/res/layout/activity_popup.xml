<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupContainer"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_deposit"
    android:padding="22dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvPopupBankName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بانک ملت"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvPopupType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="واریز به حساب"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/deposit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvPopupAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="۲,۵۰۰,۰۰۰ تومان"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/deposit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvPopupBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="متن پیامک بانکی"
        android:textSize="12sp"
        android:textColor="#555555"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnClosePopup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="تایید و بستن (۱۰)"
        android:backgroundTint="@color/primary_navy"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بدست JRweb.ir"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginTop="10dp" />

</LinearLayout>
